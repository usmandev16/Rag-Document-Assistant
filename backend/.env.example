GROQ_API_KEY=your_groq_api_key_here

# Pinecone (run `python -m src.vectorstore` once to create the index)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=rag-doc-chat
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Redis (Celery broker + result backend, chat storage, rate limits)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Limits (per browser session; 0 disables a limit)
CHAT_RATE_LIMIT_PER_MINUTE=20
UPLOAD_RATE_LIMIT_PER_MINUTE=5
TOKEN_LIMIT_PER_HOUR=0
TOKEN_LIMIT_PER_DAY=0
MAX_UPLOAD_MB=20
