GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=openai/gpt-oss-120b   # optional; must be a model your key can access
# Retrieved-context budget per question (Groq free tier: 8k tokens/min)
MAX_CONTEXT_TOKENS=3000
# Cross-encoder reranking of the top N hybrid-search results (0 = off).
# ~2.5 s per query on CPU, so off by default; 40 on faster hardware.
RERANK_TOP_K=0

# Pinecone (run `python -m src.vectorstore` once to create the index)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=rag-docs
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Redis (Celery broker + result backend, chat storage, rate limits)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Limits (0 disables a limit). Per browser session, and per client IP.
CHAT_RATE_LIMIT_PER_MINUTE=20
UPLOAD_RATE_LIMIT_PER_MINUTE=5
CHAT_RATE_LIMIT_PER_IP_PER_MINUTE=60
UPLOAD_RATE_LIMIT_PER_IP_PER_MINUTE=15
# Set to 1 only behind a reverse proxy that sets X-Forwarded-For.
TRUSTED_PROXY=0
# LLM tokens per UTC day for the whole service; above it chat returns "service busy".
DAILY_TOKEN_BUDGET=180000
TOKEN_LIMIT_PER_HOUR=0
TOKEN_LIMIT_PER_DAY=0
MAX_UPLOAD_MB=20
